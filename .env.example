# Copy to .env and fill in real values. .env is gitignored.
#
# Generate a secret key:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"

# --- Django -----------------------------------------------------------------
# Required. The app refuses to start with DEBUG=0 and no secret key.
DJANGO_SECRET_KEY=

# 0 in any deployed environment. With DEBUG=1 the app serves full tracebacks.
DJANGO_DEBUG=0

# Comma-separated hostnames this app will answer to.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Needed once you serve over HTTPS from a real domain, e.g.
# https://pokedex.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# Governs HSTS, the HTTPS redirect, and secure cookies as a group.
# MUST be 1 in any real deployment. Set to 0 only for a plain-HTTP local run:
# secure cookies are never sent over HTTP, so with this on every POST fails
# CSRF validation.
DJANGO_BEHIND_TLS=0

# locmem (default, per-process) | database | redis
# Use `database` under gunicorn so all workers share one cache -- this is what
# keeps PokeAPI move lookups from being repeated per worker.
DJANGO_CACHE_BACKEND=database
# REDIS_URL=redis://127.0.0.1:6379/0

# DEBUG | INFO | WARNING | ERROR
DJANGO_LOG_LEVEL=INFO

# --- Database ---------------------------------------------------------------
POSTGRES_DB=pokeproject_db
POSTGRES_USER=admin
# Required. Do not ship the default.
POSTGRES_PASSWORD=
# `db` inside docker compose; `localhost` when running Django on the host.
POSTGRES_HOST=db
POSTGRES_PORT=5432
